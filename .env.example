# CODELANCER dev environment example
# Copy to .env and adjust as needed for local development
#
# Usage:
#   cp .env.example .env
#   # then start with: APP_ENV=dev uvicorn codelancer.api.main:app --reload
#   # or:              codelancer dev

# Set to "dev" to enable hot-reload defaults, permissive CORS, and Swagger UI (/docs)
APP_ENV=dev

# Port to listen on (Railway injects PORT automatically; override here for local dev)
PORT=8000

# CORS allowed origins (comma-separated). Defaults to "*" in dev mode.
# In production set to your actual frontend URL, e.g.:
# CORS_ORIGINS=https://myapp.example.com
CORS_ORIGINS=*

# Database connection URL (optional). Railway injects this automatically when a
# database service is linked. Leave blank to run without a database.
# Examples:
#   postgresql://user:password@host:5432/dbname
#   sqlite:///./local.db
# DATABASE_URL=
